# Supabase project settings — Settings → API in your Supabase dashboard.
# Copy this file to .env and fill in real values.
# Without these set, the app runs fully offline against src/api/mock-data.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed to run `npm run seed` (server-side, never used by the app itself).
# SUPABASE_URL is the same value as VITE_SUPABASE_URL above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_EMAIL=
